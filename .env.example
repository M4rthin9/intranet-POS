DATABASE_URL=postgresql://ccida:CHANGE_ME@localhost:5432/ccida?schema=public
APP_ORIGIN=http://localhost:3000
# Optional additional browser origins, separated by commas. No wildcards.
APP_ALLOWED_ORIGINS=
COOKIE_SECURE=false
SESSION_HOURS=8
BACKUP_DIRECTORY=/backups
PG_BIN_DIRECTORY=
# Cloud deployments: direct TLS database URL for pg_dump (not a pooled endpoint).
BACKUP_DATABASE_URL=
# Optional private S3-compatible archive storage; required on Render's ephemeral disk.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Container deployment: set distinct owner/application credentials, URL-encoded in URLs.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_URL=
# Recovery targets a separate empty database; never overwrite the active database.
RESTORE_DATABASE_URL=
RESTORE_ADMIN_USERNAME=
RESTORE_ADMIN_PASSWORD=
# Supply these only for the one-time bootstrap command; never commit real values.
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=
