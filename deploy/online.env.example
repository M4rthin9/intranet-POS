# Run deploy/prepare-online.ps1 to create a private online environment safely.
# Keep existing database values from deploy/.env.pos-production unchanged.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
POS_HOSTNAME=cccpos.dpdns.org
# Preserve the LAN settings from the existing production file exactly.
# compose.online.yaml configures HTTPS only for the separate online-app service.
APP_ORIGIN=http://192.168.0.46:8081
APP_ALLOWED_ORIGINS=http://192.168.1.46:8081
COOKIE_SECURE=false
SESSION_HOURS=8
POS_PORT=8081
POS_BIND_ADDRESS=0.0.0.0
# Absolute path outside Git and build contexts. Never put the token itself here.
CLOUDFLARE_TUNNEL_TOKEN_FILE=C:/path/to/POS/.local/secrets/cloudflare-tunnel-token
