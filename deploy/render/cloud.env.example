# Copy to .env.cloud at the repository root (ignored by Git). Never paste secrets into chat.
# Direct/unpooled owner connection to a NEW, EMPTY Neon database, using sslmode=require.
# Setup refuses a populated database. No source database or restore is used.
MIGRATION_DATABASE_URL=
# A NEW administrator for the fresh cloud POS (minimum 14-character password).
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=
# Dedicated PRIVATE Neon Object Storage bucket for POS archives.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# Use the region returned by Neon Storage, e.g. ap-southeast-1 for Singapore.
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
