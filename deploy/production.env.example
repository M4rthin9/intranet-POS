# Docker Compose production template. Copy to a protected .env and replace every placeholder.
# Never use test/demo credentials or commit the completed file.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=postgresql://ccida_app:URL_ENCODED_APPLICATION_PASSWORD@db:5432/ccida?schema=public
MIGRATION_DATABASE_URL=postgresql://ccida_owner:URL_ENCODED_OWNER_PASSWORD@db:5432/ccida?schema=public
APP_ORIGIN=https://pos.ccida.local
COOKIE_SECURE=true
SESSION_HOURS=8
BACKUP_DIRECTORY=/backups
# Supply these only to the one-time bootstrap command, preferably as process environment variables.
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=
