# Docker Compose production template. Copy to deploy/.env.pos-production.
# Keep the existing native .env and ERP configuration unchanged.
# Never use test/demo credentials or commit the completed file.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=postgresql://ccida_app:URL_ENCODED_APPLICATION_PASSWORD@db:5432/ccida?schema=public
MIGRATION_DATABASE_URL=postgresql://ccida_owner:URL_ENCODED_OWNER_PASSWORD@db:5432/ccida?schema=public
# POS shares the server IP with ERP, publishing only port 8081.
# APP_ORIGIN is the canonical address used for generated feedback links.
# If changing POS_PORT, also update both origin settings below.
POS_BIND_ADDRESS=0.0.0.0
POS_PORT=8081
APP_ORIGIN=http://192.168.0.46:8081
APP_ALLOWED_ORIGINS=http://192.168.1.46:8081
COOKIE_SECURE=false
SESSION_HOURS=8
BACKUP_DIRECTORY=/backups
# Supply these only to the one-time bootstrap command, preferably as process environment variables.
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=
