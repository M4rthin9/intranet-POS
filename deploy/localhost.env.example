# Separate-port Docker deployment beside an existing ERP/Nginx installation.
# Copy to deploy/.env.pos-local (ignored by Git), then enter real DB passwords.
# Never replace the operational native .env or use demo/local-test credentials.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
DATABASE_URL=postgresql://ccida_app:URL_ENCODED_APPLICATION_PASSWORD@db:5432/ccida?schema=public
MIGRATION_DATABASE_URL=postgresql://ccida_owner:URL_ENCODED_OWNER_PASSWORD@db:5432/ccida?schema=public

# Server-only access. Keep POS_PORT and the port in POS_APP_ORIGIN identical.
POS_BIND_ADDRESS=127.0.0.1
POS_PORT=8081
POS_APP_ORIGIN=http://localhost:8081

# For cashier devices on this LAN, change only these two values:
# POS_BIND_ADDRESS=192.168.1.46
# POS_APP_ORIGIN=http://192.168.1.46:8081
# In LAN mode use that exact IP URL on every device, including the server.

# Provide bootstrap values through process environment only for a fresh DB.
BOOTSTRAP_USERNAME=superadmin
BOOTSTRAP_PASSWORD=
