{
  "name": "ccida-event-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-test.ts --runtime",
    "dev:runtime": "tsx scripts/dev-test.ts --runtime",
    "dev:test": "tsx scripts/dev-test.ts",
    "build": "tsx scripts/build.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "prisma validate && prisma migrate status",
    "db:test:ready": "tsx scripts/test-preflight.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "tsx scripts/migrate-test.ts",
    "db:seed": "tsx scripts/seed.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "validate:phase": "tsx scripts/validate-phase.ts",
    "backup:worker": "tsx scripts/backup-worker.ts",
    "backup:once": "tsx scripts/backup-worker.ts --once",
    "restore": "tsx scripts/restore.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "format": "prettier --write src tests scripts docs/*.md docs/phases/*.md *.ts *.mts *.mjs *.json",
    "format:check": "prettier --check src tests scripts *.ts *.mts *.mjs *.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bwip-js": "4.11.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@zxing/library": "0.23.0",
    "dotenv": "^17.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsqr": "1.4.0",
    "playwright": "^1.56.0",
    "pngjs": "7.0.0",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
